@model Segundo_Momento_Evaluativo.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3 text-center">
                <h4 class="fw-bold mb-0">Iniciar Sesión</h4>
                <small class="text-white-50">Portal de Microcursos y Tutoriales</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@univalle.edu" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe"></label>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">Ingresar al Portal</button>
                    </div>

                    <div class="text-center small text-muted">
                        ¿No tienes una cuenta aún? 
                        <a asp-action="Register" asp-route-returnUrl="@returnUrl" class="text-decoration-none fw-semibold">Registrarse</a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light p-3 border-top text-center">
                <small class="text-muted d-block fw-semibold mb-1">Credenciales de prueba del sistema:</small>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <span class="badge bg-danger p-2" title="Rol Administrador">Admin: admin@univalle.edu / Admin123!</span>
                    <span class="badge bg-success p-2" title="Rol Estudiante">Estudiante: estudiante@univalle.edu / Estudiante123!</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
