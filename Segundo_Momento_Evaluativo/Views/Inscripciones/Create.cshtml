@model Segundo_Momento_Evaluativo.Models.Inscripcion

@{
    ViewData["Title"] = "Nueva Inscripción";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="card-title fw-bold mb-0">Nueva Inscripción a Curso</h4>
                <small class="text-muted">Asigna un estudiante al catálogo de microcursos disponibles</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="CursoId" class="form-label fw-semibold">Seleccionar Curso</label>
                        <select asp-for="CursoId" class="form-select" asp-items="ViewBag.CursoId"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NombreEstudiante" class="form-label fw-semibold">Nombre Completo del Estudiante</label>
                        <input asp-for="NombreEstudiante" class="form-control" placeholder="Ej. Juan Pérez" />
                        <span asp-validation-for="NombreEstudiante" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="CorreoEstudiante" class="form-label fw-semibold">Correo Electrónico Institucional</label>
                        <input asp-for="CorreoEstudiante" class="form-control" placeholder="Ej. estudiante@univalle.edu" />
                        <span asp-validation-for="CorreoEstudiante" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Confirmar Inscripción</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

