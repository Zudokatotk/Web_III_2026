@model Segundo_Momento_Evaluativo.Models.Inscripcion

@{
    ViewData["Title"] = "Anular Inscripción";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="card-title fw-bold mb-0">Confirmar Anulación de Inscripción</h4>
                <small class="text-white-50">Se dará de baja al estudiante en el curso seleccionado</small>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">¿Está seguro de que desea anular la inscripción de este estudiante?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Curso</dt>
                    <dd class="col-sm-8 fw-bold">@(Model.Curso?.Titulo ?? "Curso no especificado")</dd>

                    <dt class="col-sm-4 text-muted">Estudiante</dt>
                    <dd class="col-sm-8">@Model.NombreEstudiante</dd>

                    <dt class="col-sm-4 text-muted">Correo Electrónico</dt>
                    <dd class="col-sm-8">@Model.CorreoEstudiante</dd>

                    <dt class="col-sm-4 text-muted">Fecha de Inscripción</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@Model.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</span></dd>
                </dl>
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">Confirmar Anulación</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
