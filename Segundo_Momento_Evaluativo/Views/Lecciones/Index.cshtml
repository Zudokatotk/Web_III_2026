@model IEnumerable<Segundo_Momento_Evaluativo.Models.Leccion>

@{
    ViewData["Title"] = "Lecciones";
    var curso = ViewData["CursoSeleccionado"] as Segundo_Momento_Evaluativo.Models.Curso;
}

<h1>Lecciones @(curso != null ? "del Curso: " + curso.Titulo : "")</h1>

<p>
    <a asp-action="Create" asp-route-cursoId="@curso?.Id" class="btn btn-primary">Crear Nueva Lección</a>
    @if (curso != null)
    {
        <a asp-controller="Cursos" asp-action="Index" class="btn btn-outline-secondary">Volver a Cursos</a>
    }
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Curso</th>
            <th>Orden</th>
            <th>Título</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Curso.Titulo)
            </td>
            <td>
                #@Html.DisplayFor(modelItem => item.Orden)
            </td>
            <td>
                <strong>@Html.DisplayFor(modelItem => item.Titulo)</strong>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Ver Contenido</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
