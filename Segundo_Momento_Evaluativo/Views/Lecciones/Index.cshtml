@model IEnumerable<Segundo_Momento_Evaluativo.Models.Leccion>

@{
    ViewData["Title"] = "Lecciones";
    var curso = ViewData["CursoSeleccionado"] as Segundo_Momento_Evaluativo.Models.Curso;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold mb-0">Lecciones @(curso != null ? "del Curso: " + curso.Titulo : "")</h2>
        <small class="text-muted">Temarios estructurados por lecciones y orden secuencial</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-cursoId="@curso?.Id" class="btn btn-primary">+ Nueva Lección</a>
        @if (curso != null)
        {
            <a asp-controller="Cursos" asp-action="Index" class="btn btn-outline-secondary">Volver a Cursos</a>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Orden</th>
                    <th>Título de la Lección</th>
                    <th>Curso Asociado</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
@if (!Model.Any()) {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No hay lecciones registradas para mostrar.</td>
                </tr>
}
@foreach (var item in Model) {
                <tr>
                    <td>
                        <span class="badge bg-light text-dark border">#@Html.DisplayFor(modelItem => item.Orden)</span>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.Titulo)</div>
                    </td>
                    <td>
                        <span class="badge bg-secondary">@(item.Curso?.Titulo ?? "General")</span>
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Ver</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

