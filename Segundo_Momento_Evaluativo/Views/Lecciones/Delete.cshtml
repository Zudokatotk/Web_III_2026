@model Segundo_Momento_Evaluativo.Models.Leccion

@{
    ViewData["Title"] = "Eliminar Lección";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="card-title fw-bold mb-0">Confirmar Eliminación de Lección</h4>
                <small class="text-white-50">Esta lección se retirará del temario del curso</small>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">¿Está seguro de que desea eliminar esta lección?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Curso Asociado</dt>
                    <dd class="col-sm-8 fw-bold">@(Model.Curso?.Titulo ?? "General")</dd>

                    <dt class="col-sm-4 text-muted">Orden en Temario</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">#@Model.Orden</span></dd>

                    <dt class="col-sm-4 text-muted">Título de la Lección</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>
                </dl>
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">Sí, Eliminar Lección</button>
                        <a asp-action="Index" asp-route-cursoId="@Model.CursoId" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

