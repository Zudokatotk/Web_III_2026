@model Segundo_Momento_Evaluativo.Models.Leccion

@{
    ViewData["Title"] = "Editar Lección";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="card-title fw-bold mb-0">Editar Lección</h4>
                <small class="text-muted">Actualiza el contenido o la posición en el temario</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FechaCreacion" />
                    <div class="mb-3">
                        <label asp-for="CursoId" class="form-label fw-semibold">Curso Asociado</label>
                        <select asp-for="CursoId" class="form-select" asp-items="ViewBag.CursoId"></select>
                        <span asp-validation-for="CursoId" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label asp-for="Titulo" class="form-label fw-semibold"></label>
                            <input asp-for="Titulo" class="form-control" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Orden" class="form-label fw-semibold"></label>
                            <input asp-for="Orden" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Orden" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Contenido" class="form-label fw-semibold"></label>
                        <textarea asp-for="Contenido" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Contenido" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

