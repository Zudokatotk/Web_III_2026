@model Segundo_Momento_Evaluativo.Models.Leccion

@{
    ViewData["Title"] = "Detalle de la Lección";
}

<h1>Detalles de la Lección</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Curso</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Curso.Titulo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Orden)</dt>
        <dd class="col-sm-9">#@Html.DisplayFor(model => model.Orden)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Titulo)</dt>
        <dd class="col-sm-9"><strong>@Html.DisplayFor(model => model.Titulo)</strong></dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaCreacion)</dt>
        <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    <h5 class="mt-4">Contenido de la Lección:</h5>
    <div class="card p-3 bg-light">
        @Html.Raw(Model.Contenido)
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar Lección</a> |
    <a asp-action="Index" asp-route-cursoId="@Model?.CursoId" class="btn btn-secondary">Volver a las lecciones</a>
</div>
