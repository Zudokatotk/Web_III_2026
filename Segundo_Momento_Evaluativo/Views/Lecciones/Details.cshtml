@model Segundo_Momento_Evaluativo.Models.Leccion

@{
    ViewData["Title"] = "Detalle de la Lección";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold mb-0">Detalles de la Lección</h2>
        <small class="text-muted">Información del temario y material didáctico</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar Lección</a>
        <a asp-action="Index" asp-route-cursoId="@Model?.CursoId" class="btn btn-outline-secondary">Volver al Listado</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-light text-dark border">Lección #@(Model?.Orden ?? 1)</span>
                    <span class="badge bg-secondary">@(Model?.Curso?.Titulo ?? "General")</span>
                </div>
                <h4 class="fw-bold text-dark mb-0">@(Model?.Titulo ?? "")</h4>
            </div>
            <div class="col-md-4 text-md-end">
                <small class="text-muted d-block">Fecha de registro:</small>
                <span class="text-secondary small">@(Model?.FechaCreacion.ToString("dd/MM/yyyy HH:mm") ?? "")</span>
            </div>
        </div>
        <hr />
        <h6 class="fw-bold text-dark mb-2">Contenido de la Lección:</h6>
        <div class="p-3 bg-light rounded border">
            @Html.Raw(Model?.Contenido ?? "")
        </div>
    </div>
</div>

