@model Segundo_Momento_Evaluativo.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<h1>Eliminar Curso</h1>

<h3>¿Está seguro de que desea eliminar este curso?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Titulo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Titulo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nivel)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nivel)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DuracionMinutos)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DuracionMinutos) min</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>
