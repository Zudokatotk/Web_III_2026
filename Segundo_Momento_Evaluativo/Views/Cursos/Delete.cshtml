@model Segundo_Momento_Evaluativo.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="card-title fw-bold mb-0">Confirmar Eliminación de Curso</h4>
                <small class="text-white-50">Esta acción eliminará también las lecciones asociadas</small>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">¿Está seguro de que desea eliminar permanentemente este curso?</p>
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Título del Curso</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Titulo</dd>

                    <dt class="col-sm-4 text-muted">Nivel</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Nivel</span></dd>

                    <dt class="col-sm-4 text-muted">Duración Estimada</dt>
                    <dd class="col-sm-8">@Model.DuracionMinutos min</dd>
                </dl>
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">Sí, Eliminar Curso</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

