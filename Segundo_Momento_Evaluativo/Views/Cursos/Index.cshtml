@model IEnumerable<Segundo_Momento_Evaluativo.Models.Curso>

@{
    ViewData["Title"] = "Cursos";
    string currentSearch = ViewData["CurrentSearch"] as string ?? "";
    string currentNivel = ViewData["CurrentNivel"] as string ?? "Todos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold mb-0">Catálogo de Cursos</h2>
        <small class="text-muted">Listado general de microcursos registrados</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Curso</a>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" value="@currentSearch" class="form-control form-control-sm" placeholder="Buscar por título o descripción..." />
            </div>
            <div class="col-md-4">
                <select name="nivel" class="form-select form-select-sm">
                    <option value="Todos" selected="@(currentNivel == "Todos")">Todos los Niveles</option>
                    <option value="Principiante" selected="@(currentNivel == "Principiante")">Principiante</option>
                    <option value="Intermedio" selected="@(currentNivel == "Intermedio")">Intermedio</option>
                    <option value="Avanzado" selected="@(currentNivel == "Avanzado")">Avanzado</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-secondary w-100">Filtrar</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Nivel</th>
                    <th>Duración</th>
                    <th>Estado</th>
                    <th>Lecciones</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
@if (!Model.Any()) {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No se encontraron cursos con los filtros aplicados.</td>
                </tr>
}
@foreach (var item in Model) {
                <tr>
                    <td>
                        <div class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.Titulo)</div>
                        <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">@Html.DisplayFor(modelItem => item.Descripcion)</small>
                    </td>
                    <td>
                        @if (item.Nivel == "Principiante")
                        {
                            <span class="badge bg-success">Principiante</span>
                        }
                        else if (item.Nivel == "Intermedio")
                        {
                            <span class="badge bg-warning text-dark">Intermedio</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Avanzado</span>
                        }
                    </td>
                    <td>
                        <span class="text-secondary">@Html.DisplayFor(modelItem => item.DuracionMinutos) min</span>
                    </td>
                    <td>
                        @if (item.EstaPublicado)
                        {
                            <span class="badge bg-success bg-opacity-75">Publicado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Borrador</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Lecciones" asp-action="Index" asp-route-cursoId="@item.Id" class="badge bg-primary text-decoration-none p-2">
                            @(item.Lecciones?.Count ?? 0) lecciones
                        </a>
                    </td>
                    <td class="text-end pe-3">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>
