@model Segundo_Momento_Evaluativo.Models.Curso

@{
    ViewData["Title"] = "Crear Curso";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="card-title fw-bold mb-0">Crear Nuevo Curso</h4>
                <small class="text-muted">Ingresa los datos para registrar un microcurso en el catálogo</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-semibold"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej. Fundamentos de ASP.NET Core" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Resumen del contenido del microcurso..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nivel" class="form-label fw-semibold"></label>
                            <select asp-for="Nivel" class="form-select">
                                <option value="Principiante">Principiante</option>
                                <option value="Intermedio">Intermedio</option>
                                <option value="Avanzado">Avanzado</option>
                            </select>
                            <span asp-validation-for="Nivel" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DuracionMinutos" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DuracionMinutos" class="form-control" type="number" />
                                <span class="input-group-text">min</span>
                            </div>
                            <span asp-validation-for="DuracionMinutos" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4 form-check">
                        <input class="form-check-input" asp-for="EstaPublicado" />
                        <label class="form-check-label" asp-for="EstaPublicado">
                            Publicar inmediatamente en el catálogo
                        </label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Guardar Curso</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

